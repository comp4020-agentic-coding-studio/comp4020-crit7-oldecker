---
import Base from "../../layouts/Base.astro";
import { currentWeekFor, dueStatus } from "../../lib/dates";
import { getCourseByCode, listAssessmentsForCourse, listResourcesForCourse } from "../../lib/db";

const code = Astro.params.code!;
const course = getCourseByCode(code);
if (!course) {
  return new Response("Course not found", { status: 404 });
}

const assessments = listAssessmentsForCourse(course.id);
const resources = listResourcesForCourse(course.id);
const currentWeek = currentWeekFor(course.termStart);
const thisWeek = currentWeek ? resources.filter((r) => r.week === currentWeek) : [];

const statusLabel = { overdue: "Overdue", "due-soon": "Due soon", upcoming: "Upcoming" } as const;
---

<Base title={`${course.code} — ${course.title}`}>
  <h1>{course.code} — {course.title}</h1>

  <section class="section">
    <h2>Overview</h2>
    <p>{course.overview}</p>
    <p>{course.term}</p>
  </section>

  <section class="section">
    <h2>This week{currentWeek ? ` (week ${currentWeek})` : ""}</h2>
    {
      currentWeek === null ? (
        <p>Outside teaching weeks.</p>
      ) : thisWeek.length === 0 ? (
        <p>No resources tagged for week {currentWeek} yet.</p>
      ) : (
        <ul class="resource-list">
          {thisWeek.map((r) => <li class="resource-item">{r.url ? <a href={r.url}>{r.title}</a> : r.title}</li>)}
        </ul>
      )
    }
  </section>

  <section class="section">
    <h2>Assessments</h2>
    {
      assessments.length === 0 ? (
        <p>No assessments yet.</p>
      ) : (
        <ul class="assessment-list">
          {assessments.map((a) => {
            const status = dueStatus(a.dueDate);
            return (
              <li class="assessment-item">
                <span class={`badge badge--${status}`}>{statusLabel[status]}</span>
                <span>{a.title}</span>
                <time datetime={a.dueDate}>{a.dueDate}</time>
                {a.weight !== null && <span>{a.weight}%</span>}
              </li>
            );
          })}
        </ul>
      )
    }

    <form method="post" action="/api/assessments">
      <input type="hidden" name="courseId" value={course.id} />
      <label for="title">Title</label>
      <input id="title" name="title" required maxlength="200" />
      <label for="dueDate">Due date</label>
      <input id="dueDate" name="dueDate" type="date" required />
      <label for="weight">Weight %</label>
      <input id="weight" name="weight" type="number" min="0" max="100" />
      <button>Add assessment</button>
    </form>
  </section>

  <section class="section">
    <h2>All resources</h2>
    {
      resources.length === 0 ? (
        <p>No resources yet.</p>
      ) : (
        <ul class="resource-list">
          {resources.map((r) => (
            <li class={`resource-item${r.week === currentWeek ? " resource-item--current" : ""}`}>
              week {r.week}: {r.url ? <a href={r.url}>{r.title}</a> : r.title}
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
