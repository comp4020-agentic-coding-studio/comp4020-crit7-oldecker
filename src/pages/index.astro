---
import Base from "../layouts/Base.astro";
import { listCourses, listUpcomingAssessments } from "../lib/db";
import { dueStatus } from "../lib/dates";

const courses = listCourses();
const dueSoon = listUpcomingAssessments(8);

const statusLabel = { overdue: "Overdue", "due-soon": "Due soon", upcoming: "Upcoming" } as const;
---

<Base title="My courses">
  <h1>What's due</h1>
  {
    dueSoon.length === 0 ? (
      <p>Nothing due — enjoy it while it lasts.</p>
    ) : (
      <ul class="due-list">
        {dueSoon.map((a) => {
          const status = dueStatus(a.dueDate);
          return (
            <li class="due-item">
              <span class={`badge badge--${status}`}>{statusLabel[status]}</span>
              <a href={`/courses/${a.courseCode}/`}>{a.courseCode}</a>
              <span>{a.title}</span>
              <time datetime={a.dueDate}>{a.dueDate}</time>
            </li>
          );
        })}
      </ul>
    )
  }

  <h2>Courses</h2>
  <div class="course-grid">
    {
      courses.map((c) => (
        <a class="course-card" href={`/courses/${c.code}/`}>
          <strong>{c.code}</strong>
          <span>{c.title}</span>
          <span>{c.term}</span>
        </a>
      ))
    }
  </div>
</Base>
